rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isHost() {
      return request.auth != null
        && exists(/databases/$(database)/documents/hosts/$(request.auth.uid))
        && get(/databases/$(database)/documents/hosts/$(request.auth.uid)).data.active == true;
    }
    function validText(value, max) {
      return value is string && value.size() > 0 && value.size() <= max && value.matches('.*[^\\s].*');
    }
    function knownSection(id) {
      return id in ['entrance','lhm','glory','response','alleluia','offertory','holy','proclamation','our-father','log','communion','thanks-giving','recessional','adoration','ash','mission-wedding','sob','way-of-the-cross','we-believe','z-grade']
        || (id is string && id.matches('section-[a-f0-9]{64}') && exists(/databases/$(database)/documents/sections/$(id)));
    }
    function activeSection(id) {
      return knownSection(id) && (!existsAfter(/databases/$(database)/documents/sectionSettings/$(id))
        || getAfter(/databases/$(database)/documents/sectionSettings/$(id)).data.removed == false);
    }
    function otherSection(id) {
      return id in ['adoration','ash','mission-wedding','sob','way-of-the-cross','we-believe','z-grade']
        || (id.matches('section-[a-f0-9]{64}') && exists(/databases/$(database)/documents/sections/$(id)));
    }
    function validLink(link) {
      return link is map && link.keys().hasOnly(['title', 'url'])
        && validText(link.title, 150) && link.url is string && link.url.size() <= 2048
        && link.url.matches('https://(drive|docs)\\.google\\.com(:443)?/[^\\s]+');
    }
    function validLinks(links) {
      return links is list && links.size() <= 10
        && (links.size() < 1 || validLink(links[0]))
        && (links.size() < 2 || validLink(links[1]))
        && (links.size() < 3 || validLink(links[2]))
        && (links.size() < 4 || validLink(links[3]))
        && (links.size() < 5 || validLink(links[4]))
        && (links.size() < 6 || validLink(links[5]))
        && (links.size() < 7 || validLink(links[6]))
        && (links.size() < 8 || validLink(links[7]))
        && (links.size() < 9 || validLink(links[8]))
        && (links.size() < 10 || validLink(links[9]));
    }
    function validRegistration(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id','sectionId','name','style','tempo','transpose','links','deleted','revision','updatedBy','updatedAt'])
        && d.id == id && id.size() <= 100
        && activeSection(d.sectionId)
        && validText(d.name, 150) && validText(d.style, 150)
        && d.tempo is int && d.tempo >= 5 && d.tempo <= 500
        && d.transpose is int && d.transpose >= -12 && d.transpose <= 12
        && validLinks(d.links) && d.deleted is bool
        && d.revision is int && d.revision > 0
        && d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }
    match /registrations/{id} {
      allow read: if true;
      allow create: if isHost() && validRegistration(id) && request.resource.data.revision == 1;
      allow update: if isHost() && validRegistration(id)
        && request.resource.data.revision == resource.data.revision + 1;
      // Use a tombstone so bundled registrations cannot reappear after deletion.
      allow delete: if false;
    }
    match /sections/{id} {
      allow read: if true;
      allow create: if isHost()
        && id.matches('section-[a-f0-9]{64}')
        && request.resource.data.keys().hasOnly(['id','title','other','createdBy','createdAt'])
        && request.resource.data.id == id && validText(request.resource.data.title, 60)
        && request.resource.data.other == true
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
      // Existing sections cannot be moved, overwritten or deleted by a client.
      allow update, delete: if false;
    }
    match /sectionSettings/{id} {
      function validSetting() {
        let d = request.resource.data;
        return otherSection(id)
          && d.keys().hasOnly(['title','removed','moveTo','revision','updatedBy','updatedAt'])
          && validText(d.title, 60) && d.removed is bool && d.moveTo is string
          && ((d.removed == false && d.moveTo == '') || (d.removed == true && d.moveTo != id && activeSection(d.moveTo)))
          && d.revision is int && d.updatedBy == request.auth.uid && d.updatedAt == request.time;
      }
      allow read: if true;
      allow create: if isHost() && validSetting() && request.resource.data.revision == 1;
      allow update: if isHost() && validSetting() && resource.data.removed == false
        && request.resource.data.revision == resource.data.revision + 1;
      // A durable move keeps old/offline registrations reachable and prevents resurrection.
      allow delete: if false;
    }
    match /hosts/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /appReleases/android {
      // Everyone can check the published APK; only the admin release process can publish it.
      allow get: if true;
      allow list, write: if false;
    }
    match /hymnLists/{slot} {
      function validPlan() {
        let d = request.resource.data;
        return slot in ['1','2','3']
          && d.keys().hasOnly(['title','text','choices','revision','updatedBy','updatedAt'])
          && validText(d.title, 80) && d.text is string && d.text.size() <= 20000
          && d.choices is map && d.choices.size() <= 200
          && d.revision is int && d.revision > 0
          && d.updatedBy == request.auth.uid && d.updatedAt == request.time;
      }
      allow read: if true;
      function guestChange() {
        let before = resource.data;
        let after = request.resource.data;
        // Literal prefix comparison, including a line boundary: existing hymns cannot be erased or rewritten.
        return after.title == before.title && (after.text == before.text
          || (after.text.size() > before.text.size() && after.text.trim().size() > 0
            && (before.text == '' || after.text[0:before.text.size()+1] == before.text + '\n')));
      }
      allow create: if request.auth != null && validPlan() && request.resource.data.revision == 1
        && (isHost() || (request.resource.data.title == 'Hymn list ' + slot && request.resource.data.text.trim().size() > 0));
      allow update: if request.auth != null && validPlan() && request.resource.data.revision == resource.data.revision + 1
        && (isHost() || guestChange());
      // Clearing resets the slot's contents and increments its revision.
      allow delete: if false;
    }
    match /chordCatalog/{id} {
      allow read: if true;
      // Only the Google Sheets sync running as the project owner publishes the list.
      allow write: if false;
    }
    match /chordSync/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /chordOverrides/{id} {
      function validOverride() {
        let d = request.resource.data;
        let registration = get(/databases/$(database)/documents/registrations/$(id)).data;
        return d.keys().hasOnly(['mode','revision','appendPending','name','sectionId','updatedBy','updatedAt'])
          && d.mode in ['automatic','enabled','disabled']
          && d.appendPending == (d.mode == 'enabled')
          && registration.deleted == false && d.name == registration.name && d.sectionId == registration.sectionId
          && d.revision is int && d.updatedBy == request.auth.uid && d.updatedAt == request.time;
      }
      allow read: if true;
      allow create: if isHost() && validOverride() && request.resource.data.revision == 1;
      allow update: if isHost() && validOverride() && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
  }
}
